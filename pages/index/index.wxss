.liquid-page{position:fixed;inset:0;background:#010204;color:#eff3f6;overflow:hidden;transition:opacity .18s ease}
.liquid-page.leaving{opacity:0}
.liquid-canvas,.gesture-surface{position:absolute;inset:0;width:100%;height:100%}
.gesture-surface{z-index:2}
.liquid-logo{position:absolute;z-index:1;width:52.8%;max-width:232px;left:50%;top:21%;transform:translate(-50%,-50%)}
.liquid-hint{position:absolute;z-index:3;bottom:8%;width:100%;text-align:center;color:#a4afba;font-size:13px;letter-spacing:1px;pointer-events:none}
.liquid-copy{position:absolute;z-index:4;top:63%;bottom:8%;left:50%;width:80%;max-width:320px;transform:translateX(-50%);opacity:0;visibility:hidden;transition:opacity .18s ease;text-align:center}
.liquid-copy.ready{opacity:1;visibility:visible}
.liquid-title{display:block;font-size:26px;font-weight:400;line-height:1.35;letter-spacing:0;margin-bottom:22px;white-space:pre-line}
.liquid-enter{position:absolute;bottom:0;left:0;right:0;width:100%;height:52px;line-height:50px;border:1px solid #e4e7ef;color:#101219;background:linear-gradient(#fafaff,#e4e5ed);border-radius:28px;font-size:16px;box-shadow:inset 0 1px 0 #fff}
.liquid-enter:after{border:none}
.solid-orb{position:absolute;left:50%;top:54%;transform:translate(-50%,-50%);width:144px;height:144px;border-radius:50%;background:#242e38;border:1px solid #8b9caa}
