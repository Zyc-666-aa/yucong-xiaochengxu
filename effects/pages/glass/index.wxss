page{background:#080b10;color:#edf2f7}.glass-page{min-height:100vh;background:#080b10}.glass-header{display:flex;align-items:center;gap:20px;padding:0 20px 16px;border-bottom:1px solid #bfd0e526}.glass-header button{margin:0;min-width:72px;min-height:44px;padding:0;background:transparent;color:#d8e5ef;text-align:left;font-size:14px;line-height:44px}.glass-header button:after,.glass-switch:after{border:0}.glass-content{padding:32px 20px}.glass-title{display:block;font-size:28px}.glass-note{display:block;font-size:14px;color:#9eacbb;line-height:1.6;margin-top:12px}.glass-stage{position:relative;width:100%;height:300px;margin-top:24px;background:#0a0b0f;border-radius:18px;overflow:hidden}.glass-canvas{width:100%;height:100%;display:block}.glass-switch{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);min-width:44px;min-height:44px;padding:0;margin:0;background:transparent;border:0;color:#e2eafa}.glass-switch-fallback{background:#233044;border:1px solid #b7cce3;border-radius:32px}.glass-fallback{position:absolute;top:30px;left:0;right:0;text-align:center;color:#a8b7c8;font-size:13px}.glass-status{display:block;margin:20px 0;text-align:center;font-size:14px;color:#b7c8da}.glass-retry{background:#202c3a;color:#e2eafa;min-height:44px;line-height:44px;border-radius:12px;font-size:14px}