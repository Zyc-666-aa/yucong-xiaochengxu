<view class="glass-page"><view class="glass-header" style="padding-top:{{top}}px"><button bindtap="back" aria-label="返回关于">‹ 关于</button><text>界面效果</text></view><view class="glass-content"><text class="glass-title">液态玻璃</text><text class="glass-note">点击开关，切换材质状态。</text><view class="glass-stage" bindtouchmove="pointer" bindtouchend="resetPointer"><canvas wx:if="{{!failed}}" id="glassCanvas" type="webgl" class="glass-canvas"></canvas><view wx:if="{{failed}}" class="glass-fallback">材质暂时无法显示</view><button class="glass-switch {{failed?'glass-switch-fallback':''}}" style="width:{{controlWidth}}px;height:{{controlHeight}}px" role="switch" aria-role="switch" aria-checked="{{on}}" aria-label="液态玻璃" bindtap="toggle"><text wx:if="{{failed}}">{{on?'开启':'关闭'}}</text></button></view><text class="glass-status" aria-live="polite">{{on?'已开启':'已关闭'}}</text><button wx:if="{{failed}}" class="glass-retry" bindtap="retry">重新加载材质</button></view></view>