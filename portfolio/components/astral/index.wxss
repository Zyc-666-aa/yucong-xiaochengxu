/* About page ambient field: edge anchored, staggered, and deliberately quiet. */
:host{pointer-events:none}
.astral{position:absolute;inset:0;width:100%;height:100%;overflow:hidden;opacity:1;pointer-events:none}
.float{position:absolute;bottom:auto;display:block;transform-origin:center;opacity:0;filter:drop-shadow(0 1rpx 3rpx #0009) saturate(.68) brightness(.78);will-change:transform,opacity}
.float-image{width:100%;height:100%;display:block}
.is-quiet{opacity:.55}
@keyframes astral-in{from{opacity:0;transform:translate3d(0,8rpx,0) scale(.96)}to{opacity:.16;transform:translate3d(0,0,0) scale(1)}}
@keyframes astral-drift{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(2rpx,-2rpx,0) scale(1.015)}}
