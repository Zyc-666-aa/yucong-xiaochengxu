<view class="portfolio">
  <view class="stars" aria-hidden="true"></view>
  <scroll-view class="page-scroll" style="height:calc(100% - {{88+bottom}}px)" scroll-y enhanced scroll-top="{{scrollTop}}" bindscroll="onScroll" show-scrollbar="{{false}}">
    <view class="page-content section-{{section}}" style="padding-top:{{contentTop}}px;padding-bottom:32px">
      <view class="content-wordmark"><image src="/assets/lush-wordmark-mobile.png" mode="aspectFit" aria-label="LUSH"></image></view>
      <block wx:if="{{section === 'work'}}">
        <view class="section-head"><text class="page-title">作品</text></view><view class="portfolio-value" aria-label="作者与设计价值"><view class="portfolio-value-copy"><text class="eyebrow">ALBERT LUSH / DESIGN VALUE</text><text class="portfolio-value-name">张誉聪 / Albert Lush</text><text class="portfolio-value-role">视觉设计、交互原型与 AI 辅助创作。</text><text class="portfolio-value-statement">把视觉想法做成可操作、可验证的作品。</text></view><view class="portfolio-value-actions"><button class="value-action" bindtap="collaboration" hover-class="press" aria-label="查看简历预览">简历 <text>&gt;</text></button><button class="value-action" data-id="lush" bindtap="openProject" hover-class="press" aria-label="查看 LUSH 重点案例">重点案例 <text>&gt;</text></button></view></view>
        <view class="filters"><button wx:for="{{categories}}" wx:key="*this" class="filter {{category === item ? 'selected' : ''}}" data-category="{{item}}" bindtap="selectCategory" hover-class="press" aria-pressed="{{category === item}}">{{item}}</button></view>
        <view class="work-list"><button wx:for="{{shown}}" wx:key="id" class="project" data-id="{{item.id}}" bindtap="openProject" hover-class="press" aria-label="{{item.title}}，{{item.subtitle}}">
          <view class="project-picture"><image wx:if="{{!failedImages[item.id]}}" src="{{item.cover}}" mode="aspectFill" data-image-id="{{item.id}}" binderror="imageError" aria-label="{{item.title}}"></image><view wx:else class="media-missing" aria-label="图片暂时无法加载">图片暂时无法加载</view><text class="project-type">{{item.status}}</text><text wx:if="{{item.id === 'lush'}}" class="project-featured">重点案例</text></view>
          <view class="project-title-line"><text class="project-name">{{item.title}}</text><text class="project-category">{{item.category}}</text></view><text class="project-subtitle">{{item.subtitle}}</text><view wx:if="{{item.cardValue}}" class="project-value-line"><text>设计价值</text><text>{{item.cardValue}}</text></view><view class="project-foot"><text>{{item.cardMeta}}</text><text class="project-explore">探索  ></text></view>
        </button></view>
        <view wx:if="{{category === 'VIBE CODING'}}" class="vibe-method" aria-label="VIBE CODING 方法链路">
          <view class="vibe-method-head"><text class="eyebrow">METHOD / 3D PROTOTYPE</text><text class="vibe-method-title">从参考图到可交互 3D</text><text class="vibe-method-lead">先冻结输入，再审资产、锁坐标，最后用真实证据收口。</text></view>
          <view class="vibe-method-list"><view wx:for="{{vibeMethod}}" wx:key="step" class="vibe-method-step"><text class="vibe-method-number">{{item.step}}</text><text class="vibe-method-step-title">{{item.title}}</text><text class="vibe-method-step-body">{{item.body}}</text></view></view>
        </view>
        <view class="page-end"><view></view><text>保持好奇，持续创作。</text><view></view></view>
      </block>
      <block wx:elif="{{section === 'lab'}}">
        <view class="section-head"><text class="eyebrow">DESIGN PROCESS</text><text class="page-title">设计工作流</text><text class="intro-line">从问题定义，到真实屏幕验证。</text></view>
        <view class="design-flow" aria-label="设计工作流树">
          <view class="design-flow-root"><text class="design-flow-index">{{designFlow.root.index}}</text><view><text class="flow-label">起点</text><text class="design-flow-root-title">{{designFlow.root.title}}</text><text class="design-flow-root-body">{{designFlow.root.body}}</text><text class="flow-thinking"><text class="flow-label">思考</text>{{designFlow.root.thinking}}</text></view></view>
          <view class="model-framework" aria-label="GPT-6 Astra 协作框架">
            <view class="model-framework-head"><text class="eyebrow">{{modelFramework.eyebrow}}</text><text class="model-framework-title">{{modelFramework.title}}</text><text class="model-framework-intro">{{modelFramework.intro}}</text></view>
            <view class="model-framework-meta"><view><text class="model-framework-meta-label">主力模型</text><text class="model-framework-meta-value">{{modelFramework.model}}</text></view><view><text class="model-framework-meta-label">负责工作</text><text class="model-framework-meta-value">{{modelFramework.role}}</text></view><view><text class="model-framework-meta-label">协作工具</text><text class="model-framework-meta-value">{{modelFramework.partners}}</text></view></view>
            <view class="model-framework-loop"><view wx:for="{{modelFramework.loop}}" wx:key="step" class="model-framework-step"><text class="model-framework-step-number">{{item.step}}</text><text class="model-framework-step-title">{{item.title}}</text><text class="model-framework-step-body">{{item.body}}</text></view></view>
            <view class="model-framework-boundary"><text class="model-framework-boundary-label">边界</text><text>{{modelFramework.boundary}}</text></view>
            <view class="model-framework-reuse"><text class="model-framework-boundary-label">复用</text><text>{{modelFramework.reuse}}</text></view>
          </view>
          <view class="design-flow-branches"><view wx:for="{{designFlow.branches}}" wx:key="id" class="design-flow-branch"><view class="design-flow-branch-head"><text class="design-flow-branch-kicker">BRANCH / {{item.id}}</text><text class="design-flow-branch-title">{{item.label}}</text><text class="design-flow-branch-note">{{item.note}}</text></view><view class="design-flow-nodes"><view wx:for="{{item.nodes}}" wx:for-item="node" wx:key="id" class="design-flow-node"><view class="design-flow-node-head"><text class="design-flow-index">{{node.index}}</text><text class="design-flow-node-title">{{node.title}}</text></view><text class="flow-process"><text class="flow-label">过程</text>{{node.process}}</text><text class="flow-thinking"><text class="flow-label">思考</text>{{node.thinking}}</text><text class="flow-evidence"><text class="flow-label">证据</text>{{node.evidence}}</text></view></view></view></view>
        </view>
        <button class="text-link" bindtap="works" hover-class="press"><text>在作品中查看结果</text><text>></text></button>
      </block>
      <block wx:elif="{{section === 'archive'}}">
        <view class="section-head"><text class="eyebrow">A COLLECTION OF IDEAS</text><text class="page-title">素材档案</text><text class="intro-line">记录过程，也保留下一次的起点。</text></view>
        <view class="archive-grid"><button wx:for="{{archive}}" wx:key="id" class="archive-item" data-id="{{item.id}}" bindtap="openArchive" hover-class="press" aria-label="{{item.title}}，{{item.type}}"><view class="archive-image"><image wx:if="{{!failedImages[item.id]}}" src="{{item.image}}" mode="aspectFit" data-image-id="{{item.id}}" binderror="imageError" aria-label="{{item.title}}"></image><view wx:else class="media-missing" aria-label="图片暂时无法加载">图片暂时无法加载</view></view><text class="archive-title">{{item.title}}</text><text class="archive-kind">{{item.type}}</text></button></view>
        <text class="archive-note">每一份素材，都属于一段具体的创作。</text>
      </block>
      <block wx:elif="{{section === 'about'}}">
        <view class="about-sky" aria-hidden="true"><astral-stream></astral-stream></view>
        <view class="about-heading"><text class="about-eyebrow">ABOUT / IDENTITY</text><view class="about-identity"><text class="about-name">张誉聪</text><text class="about-name-en">Albert Lush</text><text class="about-role">设计师 + AI 创作者</text><text class="about-statement">我把想法做成可以被看见、操作和复盘的作品。</text></view><view class="about-facts" aria-label="设计师信息"><view class="about-fact"><text>身份</text><text>服装设计学生，关注视觉、AI 与交互。</text></view><view class="about-fact"><text>优势</text><text>审美敏感，执行快，愿意试错并迭代。</text></view><view class="about-fact"><text>价值</text><text>视觉表达、AI 实验与原型实现。</text></view></view></view>
        <view class="about-actions" aria-label="下一步入口"><text class="about-actions-label">NEXT STEP / 进入作品</text><view class="about-links"><button class="link-row link-row-primary" bindtap="collaboration" hover-class="press"><view class="line-icon resume-icon" aria-hidden="true"></view><text>简历预览</text><text class="chevron" aria-hidden="true">›</text></button><button class="link-row link-row-secondary" bindtap="contact" hover-class="press"><view class="line-icon mail-icon" aria-hidden="true"></view><text>联系入口</text><text class="chevron" aria-hidden="true">›</text></button><button class="link-row link-row-tertiary knowledge-row" bindtap="openKnowledge" hover-class="press"><view class="line-icon knowledge-icon" aria-hidden="true"></view><text>知识库储备 / Obsidian</text><text class="chevron" aria-hidden="true">›</text></button></view></view>
        <view class="about-utility" aria-label="辅助功能"><text class="about-utility-label">辅助功能</text><view class="preferences"><button bindtap="openGlassLab" hover-class="press">界面效果 <text>液态玻璃</text></button><button bindtap="replay" hover-class="press">重播完整开场</button></view></view>
      </block>
    </view>
  </scroll-view>
  <view class="dock" style="padding-bottom:{{bottom}}px"><button bindtap="works" class="dock-side {{section==='work'?'current':''}}" aria-label="探索" aria-current="{{section === 'work' ? 'page' : 'false'}}" hover-class="press"><image class="nav-star" src="/assets/nav-explore.svg" aria-hidden="true"></image><text class="dock-label">探索</text></button><button bindtap="openMenu" class="dock-plus {{dockOrbFailed ? 'asset-missing' : ''}}" aria-label="打开页面目录" aria-haspopup="dialog" aria-expanded="{{menu}}" hover-class="press"><image class="dock-orb-asset" src="/assets/dock-glass-orb-v2.png" mode="aspectFit" aria-hidden="true" binderror="dockOrbError"></image></button><button bindtap="about" class="dock-side {{section==='about'?'current':''}}" aria-label="关于" aria-current="{{section === 'about' ? 'page' : 'false'}}" hover-class="press"><view class="nav-planet" aria-hidden="true"></view><text class="dock-label">关于</text></button></view>
  <view wx:if="{{menu}}" class="overlay {{sheetLeaving?'leaving':''}}" catchtap="closeMenu" catchtouchmove="noop"><view class="sheet menu-sheet" style="padding-bottom:{{bottom+20}}px" catchtap="noop"><view class="handle-area" bindtouchstart="sheetDown" bindtouchend="sheetUp"><view class="handle" aria-hidden="true"></view></view><view class="sheet-heading"><text>探索</text><button bindtap="closeMenu" aria-label="关闭目录">×</button></view><button wx:for="{{sections}}" wx:key="id" class="menu-row {{section===item.id?'active':''}}" data-id="{{item.id}}" bindtap="switchSection" hover-class="press" aria-label="{{item.label}}，{{item.note}}"><view><text>{{item.label}}</text><text>{{item.note}}</text></view><text aria-hidden="true">></text></button></view></view>
  <view wx:if="{{info}}" class="overlay {{infoLeaving?'leaving':''}}" catchtap="closeInfo" catchtouchmove="noop"><view class="sheet info-sheet" style="padding-bottom:{{bottom+28}}px" catchtap="noop"><view class="handle-area" bindtouchstart="sheetDown" bindtouchend="sheetUp"><view class="handle" aria-hidden="true"></view></view><view class="sheet-heading"><text>{{info.title}}</text><button bindtap="closeInfo" aria-label="关闭详情">×</button></view><block wx:if="{{info.image}}"><image wx:if="{{!infoImageFailed}}" class="info-image" src="{{info.image}}" mode="aspectFit" bindtap="previewInfo" binderror="infoImageError" aria-label="{{info.title}}"></image><view wx:else class="info-image media-missing" aria-label="图片暂时无法加载">图片暂时无法加载</view></block><text class="body-copy">{{info.body}}</text><block wx:if="{{info.archiveId==='intro'}}"><button class="text-link" bindtap="showIntroProject"><text>查看开场片段</text><text>></text></button></block><block wx:if="{{info.archiveId==='resume'}}"><button class="text-link" bindtap="exportResume"><text>打开简历摘要</text><text>文本</text></button><button class="text-link" bindtap="copyResume"><text>复制简历摘要</text><text>></text></button></block><block wx:if="{{info.archiveId==='contact'}}"><button class="text-link" bindtap="callPhone"><text>拨打电话</text><text>{{contact.phone}}</text></button><button class="text-link" bindtap="copyContactPart" data-kind="phone"><text>复制电话</text><text>></text></button><button class="text-link" bindtap="copyContactPart" data-kind="wechat"><text>复制微信号</text><text>></text></button><button class="text-link" bindtap="copyContactPart" data-kind="email"><text>复制邮箱</text><text>></text></button></block></view></view>
   <view wx:if="{{knowledge}}" class="knowledge-layer"><view class="knowledge-stars" aria-hidden="true"></view><view class="knowledge-header"><button bindtap="backKnowledge" aria-label="返回知识库总览"><text class="knowledge-back-glyph" aria-hidden="true">‹</text><text>知识库</text></button><text>ALBERT / OBSIDIAN</text><button bindtap="closeKnowledge" aria-label="关闭知识库">×</button></view><scroll-view class="knowledge-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view wx:if="{{knowledgeNode.id == 'root'}}" class="knowledge-root"><text class="eyebrow">OBSIDIAN / REUSABLE INDEX</text><text class="knowledge-title">{{knowledgeNode.title}}</text><text class="knowledge-intro">{{knowledgeNode.intro}}</text><view class="knowledge-principles"><view><text>参考库</text><text>{{knowledgeNode.reference}}</text></view><view><text>蒸馏方法</text><text>{{knowledgeNode.distillation}}</text></view></view><view class="knowledge-obsidian"><text>OBSIDIAN LINK</text><text>{{knowledgeNode.linkNote}}</text><button class="knowledge-open knowledge-copy-obsidian" bindtap="copyObsidianLink" hover-class="press" aria-label="复制 Obsidian 索引链接">复制 Obsidian 索引链接 <text>›</text></button></view><view class="knowledge-meta"><text>更新 {{knowledgeNode.updated}}</text><text>{{knowledgeNode.structure}}</text><text>{{knowledgeNode.status}}</text></view><view class="knowledge-node-list"><view wx:for="{{knowledgeNodes}}" wx:key="id" class="knowledge-node-card"><view class="knowledge-node-top"><text>{{item.kind}}</text><text>{{item.id}}</text></view><text class="knowledge-node-title">{{item.title}}</text><text class="knowledge-node-summary">{{item.summary}}</text><text class="knowledge-source">{{item.source}}</text><button class="knowledge-open" data-id="{{item.id}}" bindtap="selectKnowledgeNode" hover-class="press" aria-label="打开{{item.title}}">打开节点 <text>›</text></button></view></view></view><view wx:else class="knowledge-node-detail"><text class="eyebrow">{{knowledgeNode.kind}} / {{knowledgeNode.id}}</text><text class="knowledge-title">{{knowledgeNode.title}}</text><text class="knowledge-intro">{{knowledgeNode.summary}}</text><view class="knowledge-source-block"><text>Obsidian 双链</text><text>{{knowledgeNode.source}}</text></view><view class="knowledge-next"><text>继续沿链路</text><button wx:for="{{knowledgeNode.linkNodes}}" wx:key="id" class="knowledge-link" data-id="{{item.id}}" bindtap="selectKnowledgeNode" hover-class="press" aria-label="打开{{item.title}}"><text>[[ {{item.title}} ]]</text><text>›</text></button></view></view></scroll-view></view>
</view>
