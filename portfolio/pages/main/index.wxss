.portfolio .section-about .about-name{margin:14px 0 0;padding:0;color:#f0f2f5;font-size:36px;line-height:1.08;letter-spacing:0;font-weight:420}
.portfolio .section-about .about-name-en{margin-top:8px;color:#8797a7;font-size:11px;letter-spacing:.28em;line-height:1.2}
.portfolio .section-about .about-role{margin-top:15px;color:#e0e6ec;font-size:16px;line-height:1.4}
.portfolio .section-about .about-statement{max-width:640rpx;margin:9px 0 0;color:#c5d1dc;font-size:15px;line-height:1.55}
.portfolio .section-about .about-facts{margin-top:18px;border-top:1rpx solid rgba(197,216,237,.16)}
.portfolio .section-about .about-fact{display:flex;gap:12px;padding:9px 0;border-bottom:1rpx solid rgba(197,216,237,.11)}
.portfolio .section-about .about-fact>text:first-child{flex:0 0 42px;color:#b4c6d8;font-size:11px;letter-spacing:.12em;line-height:1.65}
.portfolio .section-about .about-fact>text:last-child{min-width:0;flex:1;color:#8795a5;font-size:12px;line-height:1.58}
.portfolio .section-about .about-actions{margin-top:20px}
.portfolio .section-about .about-actions-label{display:block;margin:0 0 8px;color:#708294;font-size:10px;letter-spacing:.18em;line-height:1.4}
.portfolio .section-about .about-links{max-width:none;margin:0;gap:8px}
.portfolio .section-about .link-row{min-height:44px;height:54px;border-radius:15px}
.portfolio .section-about .link-row-primary{height:58px}
.portfolio .section-about .link-row-tertiary{height:44px;padding-left:0;border-color:transparent;background:transparent;box-shadow:none;color:#8c9aa8;font-size:12px}
.portfolio .section-about .link-row-tertiary .line-icon{opacity:.68}
.portfolio .section-about .about-utility{margin-top:18px;padding-top:13px;border-top:1rpx solid rgba(197,216,237,.11)}
.portfolio .section-about .about-utility-label{display:block;color:#5f7181;font-size:10px;letter-spacing:.16em;line-height:1.4}
.portfolio .section-about .preferences{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:7px;padding:0}
.portfolio .section-about .preferences button{min-height:44px;height:44px;padding:0;border:0;border-bottom:0;border-radius:0;background:transparent;color:#728292;font-size:11px}
.portfolio .section-about .preferences button text{color:#586b7d;font-size:10px}
@media(max-width:680rpx){
  .portfolio .section-about .about-heading,.portfolio .section-about .about-actions,.portfolio .section-about .about-utility{max-width:100%}
}
@media(max-width:360px){
  .portfolio .section-about .about-heading{padding-top:12px}
  .portfolio .section-about .about-name{font-size:33px}
  .portfolio .section-about .about-statement{font-size:14px}
  .portfolio .section-about .about-fact{gap:9px}
  .portfolio .section-about .about-fact>text:first-child{flex-basis:38px}
  .portfolio .section-about .about-fact>text:last-child{font-size:11.5px}
  .portfolio .section-about .preferences{grid-template-columns:1fr}
}

/* Responsive interaction pass: keep the identity block readable before the
   project list and make the directory action discoverable. */
.portfolio .portfolio-value{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;padding:18px 16px 14px;border-color:rgba(201,221,237,.25);background:linear-gradient(150deg,rgba(20,28,37,.97),rgba(5,9,13,.98));box-shadow:inset 0 1px rgba(245,250,255,.11),0 12px 26px rgba(0,0,0,.22)}
.portfolio .portfolio-value-copy{min-width:0;min-inline-size:0}
.portfolio .portfolio-value-name{margin-top:0;font-size:26rpx;line-height:1.25;letter-spacing:.01em}
.portfolio .portfolio-value-role{margin-top:6rpx;color:#b7c6d4;font-size:19rpx;line-height:1.45}
.portfolio .portfolio-value-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));min-width:0;gap:8px;margin-top:14px}
.portfolio .value-action{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;height:46px;min-width:0;min-height:46px;padding:0 10px;overflow:hidden;border-color:rgba(191,211,228,.24);border-radius:10px;background:rgba(5,9,13,.64);color:#aebdca;font-size:19rpx;line-height:1;white-space:nowrap}
.portfolio .value-action-primary{background:linear-gradient(145deg,rgba(218,232,243,.23),rgba(33,45,57,.72));border-color:rgba(219,234,245,.5);color:#f1f5f8;box-shadow:inset 0 1px rgba(255,255,255,.12)}
.portfolio .value-action:active{transform:translateY(1px);filter:brightness(.94)}
.portfolio .value-action-chevron{position:relative;display:inline-block;width:10px;height:12px;margin-left:9px;color:#b8ccdc;flex:0 0 10px}
.portfolio .value-action-chevron::before,.portfolio .value-action-chevron::after{content:"";position:absolute;left:1px;width:7px;height:1px;background:currentColor;transform-origin:right center}
.portfolio .value-action-chevron::before{top:4px;transform:rotate(35deg)}
.portfolio .value-action-chevron::after{top:8px;transform:rotate(-35deg)}
.portfolio .dock-plus-label{position:absolute;left:50%;top:calc(100% + 5px);z-index:3;transform:translateX(-50%);pointer-events:none;color:#8e9aa6;font-size:12px;line-height:1;letter-spacing:1px;white-space:nowrap}
@media(max-width:430px){
  .portfolio .portfolio-value{grid-template-columns:minmax(0,1fr);align-items:stretch}
  .portfolio .portfolio-value-actions{width:100%;margin-top:14px;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .portfolio .value-action{width:100%;padding-left:8px;padding-right:8px}
}
@media(max-width:360px){
  .portfolio .page-content{padding-left:24rpx;padding-right:24rpx}
  .portfolio .portfolio-value{padding:18rpx 16rpx 16rpx}
  .portfolio .portfolio-value-name{font-size:24rpx}
  .portfolio .portfolio-value-role{font-size:18rpx}
  .portfolio .value-action{font-size:18rpx}
}

/* Cross-device compatibility pass: keep the same composition on Android
   phones while giving the desktop client a readable canvas and dock. */
.portfolio{overflow:hidden}
.portfolio .page-scroll{box-sizing:border-box;overscroll-behavior:contain}
.portfolio .page-content{min-width:0;overflow-wrap:anywhere;word-break:break-word}
.portfolio .project-title-line,.portfolio .project-foot,.portfolio .portfolio-value-actions{min-width:0}
.portfolio .project-name,.portfolio .project-category,.portfolio .project-subtitle,.portfolio .project-value-line text:last-child{min-width:0;overflow-wrap:anywhere;word-break:break-word}
.portfolio .dock{box-sizing:content-box;height:136rpx;padding-top:22rpx}
.portfolio.viewport-compact .page-content{padding-left:24rpx;padding-right:24rpx}
.portfolio.viewport-compact .project-picture{height:320rpx}
.portfolio.viewport-compact .project-title-line{align-items:flex-start;gap:8rpx}
.portfolio.viewport-compact .project-name{font-size:34rpx}
.portfolio.viewport-compact .project-category{max-width:38%;text-align:right}
.portfolio.viewport-wide .page-scroll{width:100%;max-width:860px;left:50%;transform:translateX(-50%)}
.portfolio.viewport-wide .page-content{max-width:800px;margin:0 auto;padding-left:32px;padding-right:32px}
.portfolio.viewport-wide .section-head{padding-top:24px;padding-bottom:30px}
.portfolio.viewport-wide .project-picture{height:340px}
.portfolio.viewport-wide .work-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.portfolio.viewport-wide .project{margin-bottom:0}
.portfolio.viewport-wide .archive-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 20px}
.portfolio.viewport-wide .archive-image{height:220px}
.portfolio.viewport-wide .dock{left:50%;right:auto;width:calc(100% - 32px);max-width:800px;transform:translateX(-50%);height:88px;padding-top:16px}
.portfolio.viewport-wide .dock-side{width:96px;height:64px}
.portfolio.viewport-wide .dock-plus{width:64px;height:64px}
.portfolio.viewport-wide .dock-label{font-size:13px}
.portfolio.viewport-wide .dock-plus-label{font-size:12px}
.portfolio.viewport-wide .sheet{width:680px;max-width:calc(100% - 32px);margin:0 auto;box-sizing:border-box}
.portfolio.viewport-wide .menu-sheet{max-height:88vh;overflow-y:auto}
