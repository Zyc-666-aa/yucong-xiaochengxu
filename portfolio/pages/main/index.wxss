/* UI audit refinement: keep the existing astral language while tightening hierarchy. */
.section-head{padding:24rpx 0 30rpx}
.page-title{font-size:60rpx;letter-spacing:-1rpx}
.intro-line{font-size:23rpx;color:#aeb8c2}
.filters{margin-bottom:26rpx;border-color:#d2deeb2b}
.filter{height:56px;line-height:56px;font-size:22rpx;touch-action:manipulation}
.filter{white-space:nowrap}
.filter:last-child{font-size:21rpx;letter-spacing:-.2rpx}
.filter.selected{height:42px;line-height:42px;margin:7px 2rpx;background:#f1f3f4;color:#101418}
.project{margin-bottom:34rpx;padding:0 0 18rpx;border:1rpx solid #b8c9d52e;border-radius:22rpx;background:linear-gradient(140deg,#101419b8,#030506 78%);overflow:hidden;touch-action:manipulation}
.project-picture{height:350rpx;border:0;border-radius:0;background:#040506}
.project-type{top:16rpx;left:16rpx}
.project-title-line{margin:18rpx 24rpx 4rpx}
.project-subtitle{margin:0 24rpx;font-size:23rpx}
.project-foot{margin:12rpx 24rpx 0;padding-top:10rpx}
.dock{border-top:1rpx solid #c6d5e21c;background:linear-gradient(transparent,#000 42%)}
.dock:before{content:"";position:absolute;left:44rpx;right:44rpx;top:0;height:1rpx;background:#c6d5e226}
button{touch-action:manipulation}
button:focus{outline:1rpx solid #d9e7f4;outline-offset:3rpx}
.about-sky{height:270rpx}
.content-wordmark{display:flex;align-items:center;justify-content:flex-start;height:32px;margin:0 0 16rpx}
.content-wordmark image{display:block;width:96px;height:32px;object-fit:contain;object-position:left center}
.section-work .content-wordmark{transform:translateY(-20rpx);margin-bottom:-8rpx}
.dock{background:linear-gradient(transparent,#000 82%)}
.page-scroll{height:calc(100% - 136rpx)}
.filter.selected{height:44px;line-height:44px;margin:6px 2rpx}
.project-picture,.lab-image,.archive-image{position:relative}
.media-missing{position:relative;background:#10141a!important;display:flex;align-items:center;justify-content:center;color:#8d9aa8;font-size:22rpx;text-align:center}
.project-picture>.media-missing,.lab-image>.media-missing,.archive-image>.media-missing{position:absolute;inset:0}
/* About refinement: editorial type, quiet steel surfaces, and distinct line icons. */
.about-name{font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Helvetica Neue","PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",sans-serif;font-size:54rpx;font-weight:400;letter-spacing:2rpx;line-height:1.2;margin-top:38rpx;color:#f0f2f5}
.about-name-en{display:block;margin-top:10rpx;color:#8f9aa6;font-size:20rpx;letter-spacing:4rpx}
.about-role{margin-top:24rpx;color:#e2e6ec}
.about-body{max-width:560rpx;margin:24rpx auto 0}
.about-links{margin-top:46rpx;gap:16rpx}
.link-row{height:108rpx;border-color:#b7c7d45c;background:linear-gradient(110deg,#11161c9c,#050608);box-shadow:inset 0 2rpx #e2edf41a,0 8rpx 28rpx #0008;transition:transform 140ms cubic-bezier(.23,1,.32,1),border-color 140ms cubic-bezier(.23,1,.32,1),background 140ms cubic-bezier(.23,1,.32,1)}
.link-row:active{transform:scale(.985);border-color:#d5e5f080;background:#12171c}
.line-icon{position:relative;width:54rpx;height:54rpx;border:1rpx solid #9eafbf66;border-radius:16rpx;background:linear-gradient(145deg,#151b22,#06080a);box-shadow:inset 0 2rpx #fff1;flex:0 0 auto}
.resume-icon:before{content:"";position:absolute;inset:11rpx 13rpx 11rpx 14rpx;border:1rpx solid #cbd6df;border-radius:3rpx}
.resume-icon:after{content:"";position:absolute;left:22rpx;right:17rpx;top:22rpx;height:1rpx;background:#cbd6df;box-shadow:0 10rpx #cbd6df}
.mail-icon{border-radius:50%;border-color:#aebdca77}
.mail-icon:before{content:"";position:absolute;inset:13rpx 9rpx;border:1rpx solid #cbd6df;border-radius:7rpx;transform:rotate(-10deg)}
.mail-icon:after{content:"";position:absolute;left:16rpx;top:24rpx;width:18rpx;height:11rpx;border-left:1rpx solid #cbd6df;border-bottom:1rpx solid #cbd6df;transform:rotate(-45deg)}

/* Final audit pass: keep the fixed dock clear of content and quiet the about sky. */
.about-sky{opacity:.94}
@media(max-width:340px){
  .filter{font-size:21rpx;padding-left:2rpx;padding-right:2rpx}
  .filter:last-child{font-size:19rpx;letter-spacing:-.35rpx}
}

/* Meteor accents: tiny and infrequent, kept behind portfolio content. */
.stars:before,.stars:after{content:"";position:absolute;z-index:1;width:28rpx;height:2rpx;border-radius:999rpx;background:linear-gradient(90deg,transparent,#c9d7e4cc 48%,transparent);opacity:0;pointer-events:none;transform-origin:left center;animation:meteor-pass 18s linear infinite}
.stars:before{left:14%;top:24%;animation-delay:-7s}
.stars:after{left:73%;top:48%;width:20rpx;animation-duration:23s;animation-delay:-15s;background:linear-gradient(90deg,transparent,#d6e1ecaa 48%,transparent)}
@keyframes meteor-pass{0%,78%{opacity:0;transform:translate3d(0,0,0) rotate(-28deg) scaleX(.35)}82%{opacity:.18;transform:translate3d(16rpx,10rpx,0) rotate(-28deg) scaleX(.7)}86%{opacity:.24;transform:translate3d(44rpx,28rpx,0) rotate(-28deg) scaleX(1)}90%{opacity:.1;transform:translate3d(76rpx,50rpx,0) rotate(-28deg) scaleX(.72)}94%,100%{opacity:0;transform:translate3d(108rpx,70rpx,0) rotate(-28deg) scaleX(.3)}}
.portfolio.reduced .stars:before,.portfolio.reduced .stars:after{animation:none;opacity:0}
.info-sheet{max-height:88vh;overflow-y:auto}
.dock{box-sizing:border-box}

.knowledge-icon{border-radius:50%;border-color:#aebdca77}
.knowledge-icon:before,.knowledge-icon:after{content:"";position:absolute;border:1rpx solid #cbd6df;border-radius:50%}
.knowledge-icon:before{width:16rpx;height:16rpx;left:10rpx;top:10rpx}
.knowledge-icon:after{width:6rpx;height:6rpx;right:7rpx;bottom:7rpx;background:#cbd6df}
.knowledge-layer{position:fixed;inset:0;z-index:60;overflow:hidden;background:#030508;color:#f2f3f5}
.knowledge-stars{position:absolute;inset:0;opacity:.24;pointer-events:none;background-image:radial-gradient(1rpx 1rpx at 21% 14%,#fff 50%,transparent),radial-gradient(1rpx 1rpx at 73% 31%,#b7c9db 50%,transparent),radial-gradient(1rpx 1rpx at 49% 77%,#a0aab5 50%,transparent);background-size:137rpx 191rpx,223rpx 179rpx,251rpx 277rpx}
.knowledge-stars:before,.knowledge-stars:after{content:"";position:absolute;width:28rpx;height:2rpx;border-radius:999rpx;background:linear-gradient(90deg,transparent,#c9d7e4aa 48%,transparent);opacity:.16;transform:rotate(-28deg)}
.knowledge-stars:before{left:16%;top:25%}.knowledge-stars:after{left:76%;top:52%;width:22rpx}
.knowledge-header{position:relative;z-index:2;height:88rpx;display:flex;align-items:center;justify-content:space-between;padding:0 24rpx;border-bottom:1rpx solid #c5d8ed28;background:linear-gradient(180deg,#090d12f2,#05080cdd)}
.knowledge-header>text{color:#8194a8;font-size:17rpx;letter-spacing:2rpx}
.knowledge-header button{min-width:160rpx;min-height:44px;padding:0 10rpx;border-radius:999rpx;background:transparent;color:#dce4ec;font-size:23rpx;text-align:left}.knowledge-back-glyph{display:inline-block;margin-right:10rpx;color:#e3ebf3;font-family:Arial,sans-serif;font-size:52rpx;font-weight:200;line-height:.7;vertical-align:-5rpx}
.knowledge-header button:last-child{min-width:44px;width:44px;padding:0;text-align:center;color:#aab6c2;font-size:38rpx;font-weight:200}
.knowledge-scroll{position:relative;z-index:1;width:100%;height:calc(100% - 88rpx);box-sizing:border-box}
.knowledge-root,.knowledge-node-detail{padding:54rpx 38rpx 160rpx}
.knowledge-title{display:block;margin-top:18rpx;color:#eef2f6;font-size:58rpx;font-weight:300;line-height:1.2}
.knowledge-intro{display:block;margin-top:22rpx;color:#9ba8b7;font-size:24rpx;line-height:1.8}
.knowledge-principles{display:flex;gap:12rpx;margin-top:18rpx}
.knowledge-principles>view{flex:1;min-width:0;padding:12rpx;border:1rpx solid #c5d8ed24;border-radius:10rpx;background:linear-gradient(145deg,#0c1219aa,#05070a)}
.knowledge-principles>view>text{display:block;color:#8293a3;font-size:18rpx;line-height:1.65}
.knowledge-principles>view>text:first-child{color:#cbd8e4;font-size:20rpx;letter-spacing:1rpx}
.knowledge-obsidian{margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid #c5d8ed22}
.knowledge-obsidian>text{display:block;color:#8293a3;font-size:18rpx;line-height:1.65}
.knowledge-obsidian>text:first-child{color:#aebfd0;font-size:20rpx;letter-spacing:1rpx}
.knowledge-copy-obsidian{margin-top:8rpx}
.knowledge-meta{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}
.knowledge-meta text{padding:8rpx 12rpx;border:1rpx solid #c5d8ed2b;border-radius:999rpx;color:#9fb1c4;font-size:17rpx;line-height:1.2}
.knowledge-node-list{margin-top:30rpx}
.knowledge-node-card{min-width:0;padding:22rpx 20rpx 20rpx;margin-bottom:16rpx;border:1rpx solid #c5d8ed28;border-radius:16rpx;background:linear-gradient(145deg,#0c1219e6,#06090d);box-shadow:inset 0 1rpx #ffffff0b}
.knowledge-node-top{display:flex;align-items:center;justify-content:space-between;color:#8194a8;font-size:18rpx;letter-spacing:1rpx}
.knowledge-node-title{display:block;margin-top:14rpx;color:#e5ebf1;font-size:30rpx;font-weight:300}
.knowledge-node-summary{display:block;margin-top:8rpx;color:#8f9dad;font-size:21rpx;line-height:1.7}
.knowledge-source,.knowledge-source-block text:last-child{display:block;margin-top:10rpx;color:#91a9c0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:18rpx;line-height:1.5;overflow-wrap:anywhere}
.knowledge-open,.knowledge-link{display:flex;width:100%;min-height:52px;align-items:center;justify-content:space-between;margin-top:12rpx;padding:0;border-top:1rpx solid #c5d8ed18;background:transparent;color:#d5e0ea;font-size:21rpx;text-align:left}
.knowledge-open text:last-child,.knowledge-link text:last-child{color:#9db0c2;font-size:36rpx;font-weight:200}
.knowledge-node-detail .knowledge-source-block{margin-top:28rpx;padding:18rpx 0;border-top:1rpx solid #c5d8ed22;border-bottom:1rpx solid #c5d8ed18}
.knowledge-source-block text:first-child,.knowledge-next>text:first-child{display:block;color:#aebfd0;font-size:20rpx;letter-spacing:1rpx}
.knowledge-next{margin-top:26rpx;padding-bottom:24rpx}
.knowledge-link{margin-top:0;padding:0 2rpx}
.knowledge-link text:first-child{color:#9bb1c6}
@media(max-width:720rpx){.knowledge-root,.knowledge-node-detail{padding-left:30rpx;padding-right:30rpx}.knowledge-title{font-size:52rpx}}

/* About page ambient field: preserve the original vertical rhythm while letting
   the decorative layer span the full scroll surface behind the copy. */
.section-about{position:relative;padding-top:270rpx!important}
.section-about .about-sky{position:absolute;inset:0;width:100%;height:100%;padding:0;pointer-events:none;z-index:0}
.section-about .about-heading,.section-about .about-links,.section-about .markers,.section-about .preferences,.section-about .content-wordmark{position:relative;z-index:1}

/* Dock refinement: readable Chinese labels and a restrained optical sphere for
   the directory action. The three-point navigation stays in place. */
.dock-side{height:112rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx}
.dock-side .nav-star,.dock-side .nav-planet{flex:0 0 auto}
