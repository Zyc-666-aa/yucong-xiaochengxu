.document-preview-image-wrap{position:relative}
.document-preview-loading{z-index:1}
@keyframes shine{0%{background-position:0}60%{background-position:180rpx}100%{background-position:180rpx}}
@media(prefers-reduced-motion:reduce){.btn-shine{animation:none;background-position:90rpx}}

.detail-nav{left:0;right:0;display:flex;align-items:center;gap:8px;height:52px;padding:0 12px;background:#080d13;z-index:5;border-bottom:1px solid #bdd0e529;box-sizing:border-box}
.detail-nav>button{min-width:62px;width:62px;padding:0 4px;justify-content:flex-start;font-size:13px}
.detail-index{display:flex;flex:1;justify-content:flex-end}
.detail-index button{min-width:44px;height:44px;line-height:44px;margin:0;padding:0 8px;font-size:12px;color:#94a5b8;border-radius:8px}
.detail-index button[aria-current="location"]{color:#eff5fb;background:#c5d9f014}
.detail-evidence-link{display:block;min-height:44px;line-height:44px;margin:0 0 16px;padding:0;background:transparent;color:#dceafa;border-bottom:1px solid #bdd0e53a;text-align:left;font-size:14px}

/* LUSH process evidence: the native tool record leads, adapters stay labelled. */
.native-evidence,.detail-framework,.figma-structure{margin:28rpx 0 0;padding:24rpx 0 10rpx;border-top:1rpx solid #c2daed2b;border-bottom:1rpx solid #c2daed1a}
.native-evidence-head>text:first-child,.framework-head>text:first-child,.figma-head>text:first-child{display:block;color:#8194a8;font-size:18rpx;letter-spacing:2rpx}
.native-evidence-head>text:nth-child(2),.framework-head>text:nth-child(2),.figma-head>text:nth-child(2){display:block;margin-top:7rpx;color:#e8eef4;font-size:30rpx;font-weight:350;letter-spacing:1rpx}
.native-evidence-head>text:last-child,.framework-head>text:last-child,.figma-head>text:last-child{display:block;margin-top:9rpx;color:#8c9cad;font-size:20rpx;line-height:1.7}
.native-evidence-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:18rpx}
.native-evidence-card{width:calc(50% - 8rpx);min-width:0;border:1rpx solid #c5d8ed24;border-radius:14rpx;background:#0b1016;overflow:hidden;box-sizing:border-box;box-shadow:inset 0 1rpx #ffffff08}
.native-evidence-image{position:relative;height:244rpx;display:flex;align-items:center;justify-content:center;background:#06090d;overflow:hidden}
.native-evidence-image image{display:block;width:100%;height:100%;object-fit:contain;object-position:center;background:#06090d}
.native-evidence-image>text{position:absolute;left:10rpx;top:10rpx;min-width:28rpx;padding:4rpx 7rpx;border:1rpx solid #dce8f355;border-radius:999rpx;background:#05070dcc;color:#e3ebf3;font-size:18rpx;line-height:1;text-align:center;letter-spacing:1rpx}
.native-evidence-caption{padding:12rpx 13rpx 14rpx}
.native-evidence-caption>text:first-child{display:block;color:#e3e9ef;font-size:25rpx;font-weight:450}
.native-evidence-caption>text:nth-child(2){display:block;margin-top:5rpx;color:#9aafc1;font-size:18rpx;line-height:1.45;letter-spacing:.3rpx}
.native-evidence-caption>text:last-child{display:block;margin-top:7rpx;color:#718294;font-size:19rpx;line-height:1.6}
.evidence-boundary,.framework-footer,.figma-note{display:block;margin:16rpx 0 0;padding:11rpx 13rpx;border-left:1rpx solid #a9c6e06b;background:#a9c6e00a;color:#8799aa;font-size:19rpx;line-height:1.7}
.framework-flow{display:flex;align-items:stretch;gap:10rpx;margin-top:18rpx;overflow-x:auto;padding-bottom:4rpx}
.framework-node{position:relative;min-width:140rpx;flex:1;padding:14rpx 13rpx 15rpx;border:1rpx solid #c5d8ed29;border-radius:10rpx;background:linear-gradient(145deg,#111b25e6,#070b10eb)}
.framework-node>text:first-child{display:block;color:#8fa9c0;font-size:18rpx;line-height:1;letter-spacing:1rpx}
.framework-node>text:nth-child(2){display:block;margin-top:12rpx;color:#e3e9ef;font-size:24rpx;font-weight:450}
.framework-node>text:last-child{display:block;margin-top:7rpx;color:#8192a2;font-size:19rpx;line-height:1.55}
.framework-arrow{align-self:center;flex:0 0 auto;color:#8ea1b3;font-size:34rpx}
.figma-frame{margin-top:18rpx;padding:12rpx;border:1rpx solid #c5d8ed29;border-radius:12rpx;background:#0b1016}
.figma-toolbar{height:26rpx;display:flex;align-items:center;color:#9eb2c5;font-size:18rpx;letter-spacing:.5rpx}
.figma-frame-grid{display:flex;flex-wrap:wrap;gap:8rpx}
.figma-frame-card{width:calc(25% - 6rpx);min-height:102rpx;padding:12rpx;border:1rpx solid #c5d8ed1f;border-radius:8rpx;background:linear-gradient(155deg,#131f2bd1,#080c11e6);box-sizing:border-box}
.figma-frame-card>text:first-child{display:block;color:#8fa9c0;font-size:17rpx;line-height:1;letter-spacing:1rpx}
.figma-frame-card>text:nth-child(2){display:block;margin-top:14rpx;color:#e3e9ef;font-size:22rpx;font-weight:450}
.figma-frame-card>text:last-child{display:block;margin-top:6rpx;color:#8192a2;font-size:17rpx;line-height:1.5}
@media(max-width:720rpx){
  .native-evidence-card{width:100%}
  .native-evidence-image{height:260rpx}
  .framework-flow{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:visible}
  .framework-arrow{display:none}
  .figma-frame-card{width:calc(50% - 4rpx)}
}


/* Design value pass 2026-09-15: case conclusion is visible before the long narrative. */
.detail-quick-read{margin:28rpx 0 0;padding:20rpx 0 6rpx;border-top:1rpx solid rgba(194,218,237,.26);border-bottom:1rpx solid rgba(194,218,237,.16)}.quick-read-head{display:flex;align-items:baseline;justify-content:space-between;gap:20rpx;margin-bottom:8rpx}.quick-read-head>text:first-child{color:#8194a8;font-size:18rpx;letter-spacing:2rpx}.quick-read-head>text:last-child{color:#e8eef4;font-size:30rpx;font-weight:300}.quick-read-grid{display:flex;gap:22rpx}.quick-read-row{flex:1;min-width:0;padding:16rpx 0;border-top:1rpx solid #c5d8ed14}.quick-read-row>text:first-child{display:block;color:#b3c6d7;font-size:19rpx;letter-spacing:1rpx}.quick-read-row>text:last-child{display:block;margin-top:6rpx;color:#8496a7;font-size:21rpx;line-height:1.65}.detail-quick-read+.lead{margin-top:24rpx}
@media(max-width:720rpx){.quick-read-grid{display:block}.quick-read-row{display:grid;grid-template-columns:100rpx minmax(0,1fr);gap:14rpx}.quick-read-row>text:last-child{margin-top:0}}
