/* Unified loading state 2026-09-14: silver sweep for waiting content only. */
.btn-shine{
  position:absolute;
  top:50%;
  left:50%;
  right:auto;
  transform:translate(-50%,-50%);
  display:block;
  width:max-content;
  max-width:calc(100% - 48rpx);
  padding:12rpx 96rpx;
  color:#fff;
  background:linear-gradient(to right,#9f9f9f 0,#fff 10%,#868686 20%);
  background-position:0;
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
  animation:shine 3s infinite linear;
  animation-fill-mode:forwards;
  font-weight:600;
  font-size:26rpx;
  line-height:1.4;
  white-space:nowrap;
  font-family:"Poppins","SF Pro Display","Noto Sans SC","Microsoft YaHei",sans-serif;
  text-align:center;
  pointer-events:none;
}
