<view class="detail-page platform-{{platformClass}} viewport-{{viewportClass}}"><view class="detail-nav" style="top:{{top}}px"><button bindtap="back" hover-class="press" aria-label="返回作品列表"><text aria-hidden="true">‹</text>作品</button><view class="detail-index"><button wx:for="{{sections}}" wx:key="id" data-id="{{item.id}}" bindtap="jumpSection" aria-current="{{activeSection===item.id?'location':'false'}}">{{item.label}}</button></view></view><scroll-view scroll-y scroll-top="{{targetScroll}}" bindscroll="onDetailScroll" style="top:{{top+52}}px;height:calc(100% - {{top+52}}px)" class="detail-scroll" show-scrollbar="{{false}}"><view class="detail-content" style="padding-top:20px;padding-bottom:{{bottom+32}}px"><view class="detail-scroll-wordmark"><image src="/assets/lush-wordmark-mobile.png" mode="aspectFit" aria-label="LUSH"></image></view><block wx:if="{{item}}"><text class="eyebrow">{{item.status}} / {{item.category}}</text><text id="case-summary" class="title">{{item.title}}</text><text class="subtitle">{{item.subtitle}}</text><view wx:if="{{item.snapshot}}" class="detail-quick-read" id="case-result" aria-label="案例快速阅读"><view class="quick-read-head"><text>30 SECOND READ</text><text>先看价值</text></view><view class="quick-read-grid"><view class="quick-read-row"><text>设计价值</text><text>{{item.snapshot.value}}</text></view><view class="quick-read-row"><text>我的范围</text><text>{{item.snapshot.scope}}</text></view><view class="quick-read-row"><text>阶段结果</text><text>{{item.snapshot.result}}</text></view></view></view><button wx:if="{{item.documents.length}}" class="detail-evidence-link" data-id="documents" bindtap="jumpSection">查看 {{item.documents.length}} 页项目资料</button><image wx:if="{{!coverFailed}}" class="cover" src="{{item.cover}}" mode="widthFix" data-src="{{item.cover}}" aria-label="查看{{item.title}}作品大图" bindtap="preview" binderror="coverError"></image><view wx:else class="cover media-missing" aria-label="图片暂时无法加载">图片暂时无法加载</view><view class="project-meta"><view><text>角色</text><text>{{item.role}}</text></view><view><text>时间</text><text>{{item.year}}</text></view></view><text class="lead">{{item.intro}}</text><view wx:if="{{item.snapshot}}" class="detail-snapshot"><view class="snapshot-head"><text>PROJECT SNAPSHOT</text><text>项目摘要</text></view><view class="snapshot-grid"><view class="snapshot-row"><text>项目价值</text><text>{{item.snapshot.value}}</text></view><view class="snapshot-row"><text>项目目标</text><text>{{item.snapshot.goal}}</text></view><view class="snapshot-row"><text>核心用户</text><text>{{item.snapshot.user}}</text></view><view class="snapshot-row"><text>我的范围</text><text>{{item.snapshot.scope}}</text></view><view class="snapshot-row"><text>核心挑战</text><text>{{item.snapshot.challenge}}</text></view><view class="snapshot-row"><text>证据边界</text><text>{{item.snapshot.evidence}}</text></view><view class="snapshot-row"><text>阶段结果</text><text>{{item.snapshot.result}}</text></view></view></view><view wx:if="{{item.tools || item.references}}" class="detail-tooling"><view class="tooling-head"><text>MAKING NOTES</text><text>制作与参考</text></view><view class="tooling-grid"><view wx:if="{{item.tools}}" class="tooling-row"><text>制作工具</text><text>{{item.tools}}</text></view><view wx:if="{{item.references}}" class="tooling-row"><text>参考来源</text><text>{{item.references}}</text></view></view></view><view wx:if="{{item.journey}}" id="case-process" class="detail-journey"><view class="journey-head"><text>DESIGN PROCESS</text><text>设计历程与 AI 使用</text></view><text class="journey-intro">{{item.journey.intro}}</text><view wx:if="{{item.journey.visual}}" class="journey-visual"><image lazy-load="true" src="{{item.journey.visual.src}}" mode="aspectFill" aria-label="{{item.journey.visual.alt}}"></image><text>{{item.journey.visual.caption}}</text></view><view wx:if="{{item.journey.nativeEvidence}}" class="native-evidence"><view class="native-evidence-head"><text>WECHAT DEVTOOLS / RESULT</text><text>{{item.journey.nativeEvidence.title}}</text><text>{{item.journey.nativeEvidence.intro}}</text></view><view class="native-evidence-grid"><view wx:for="{{item.journey.nativeEvidence.images}}" wx:for-item="entry" wx:for-index="index" wx:key="title" class="native-evidence-card"><view class="native-evidence-image"><image lazy-load="true" src="{{entry.src}}" mode="aspectFit" aria-label="{{entry.title}}：{{entry.source}}"></image><text>{{index + 1}}</text></view><view class="native-evidence-caption"><text>{{entry.title}}</text><text>{{entry.source}}</text><text>{{entry.note}}</text></view></view></view><text class="evidence-boundary">{{item.journey.nativeEvidence.boundary}}</text></view><view wx:if="{{item.journey.framework}}" class="detail-framework"><view class="framework-head"><text>PRODUCT FRAMEWORK</text><text>{{item.journey.framework.title}}</text><text>{{item.journey.framework.intro}}</text></view><view class="framework-flow"><view wx:for="{{item.journey.framework.nodes}}" wx:for-item="node" wx:for-index="index" wx:key="label" class="framework-node"><text>{{index + 1}}</text><text>{{node.label}}</text><text>{{node.detail}}</text></view></view><text class="framework-footer">{{item.journey.framework.footer}}</text></view><view wx:if="{{item.journey.figma}}" class="figma-structure"><view class="figma-head"><text>FIGMA / STRUCTURE</text><text>{{item.journey.figma.title}}</text><text>{{item.journey.figma.intro}}</text></view><view class="figma-frame"><view class="figma-toolbar"><text>页面与状态</text></view><view class="figma-frame-grid"><view wx:for="{{item.journey.figma.frames}}" wx:for-item="frame" wx:for-index="index" wx:key="label" class="figma-frame-card"><text>{{index + 1}}</text><text>{{frame.label}}</text><text>{{frame.detail}}</text></view></view></view><text class="figma-note">{{item.journey.figma.note}}</text></view><view wx:if="{{item.journey.process && item.journey.process.length}}" class="process-board"><view class="process-board-head"><text>PROCESS EVIDENCE</text><text>过程证据图</text><text>把实际展板、原型截图和当时的判断放在同一条线上，先看证据，再看解释。</text></view><view class="process-board-grid"><view wx:for="{{item.journey.process}}" wx:for-item="step" wx:key="step" class="process-card"><view class="process-card-image"><image lazy-load="true" src="{{step.image}}" mode="aspectFill" aria-label="{{step.title}}：{{step.source}}"></image><text>{{step.step}}</text></view><view class="process-card-caption"><text>{{step.title}}</text><text>{{step.source}}</text><text>{{step.note}}</text></view></view></view></view><view class="journey-steps"><view wx:for="{{item.journey.steps}}" wx:for-item="step" wx:key="title" class="journey-step"><text>{{step.title}}</text><text>{{step.body}}</text></view></view><view wx:if="{{item.journey.reviews && item.journey.reviews.length}}" id="case-review" class="journey-review"><view class="review-head"><text>PROJECT RETROSPECT</text><text>{{item.journey.reviewTitle}}</text></view><text class="review-intro">{{item.journey.reviewIntro}}</text><view class="review-list"><view wx:for="{{item.journey.reviews}}" wx:for-item="review" wx:for-index="index" wx:key="mistake" class="review-item"><text class="review-index">{{index + 1}}</text><view class="review-field"><text class="review-label">当时的偏差</text><text>{{review.mistake}}</text></view><view class="review-field"><text class="review-label">带来的影响</text><text>{{review.impact}}</text></view><view class="review-field"><text class="review-label">现在会怎么改</text><text>{{review.change}}</text></view></view></view></view><view class="journey-ai"><text>{{item.journey.aiTitle}}</text><text>{{item.journey.ai}}</text></view></view><text class="detail-analysis-intro">下面按业务背景到下一步拆开，保留当时的判断，也标出尚未验证的部分。</text><view class="case-section" wx:for="{{item.sections}}" wx:for-item="section" wx:key="title"><text class="section-title">{{section.title}}</text><view wx:if="{{section.visual}}" class="section-visual"><image lazy-load="true" src="{{section.visual.src}}" mode="aspectFill" aria-label="{{section.visual.alt}}"></image><text>{{section.visual.caption}}</text></view><text class="body">{{section.body}}</text><view wx:if="{{section.chain || section.decision}}" class="section-analysis"><view wx:if="{{section.chain}}" class="analysis-row"><text class="analysis-label">链路</text><text class="analysis-copy">{{section.chain}}</text></view><view wx:if="{{section.decision}}" class="analysis-row"><text class="analysis-label">我的决策</text><text class="analysis-copy">{{section.decision}}</text></view></view></view><block wx:if="{{item.documents && item.documents.length}}"><view id="case-documents" class="case-section project-documents"><text class="section-title">项目资料</text><text class="body">{{item.documents.length}} 页项目资料合并为一个设计作品，点击缩略图查看完整页面。</text><view class="document-grid"><button wx:for="{{item.documents}}" wx:for-item="doc" wx:for-index="index" wx:key="id" class="document-card" data-doc-id="{{doc.id}}" bindtap="previewDocument" hover-class="press" aria-label="查看{{doc.title}}页面"><view class="document-thumb"><image src="{{doc.preview}}" mode="aspectFit" aria-hidden="true"></image><text class="document-index">{{index + 1}} / {{item.documents.length}}</text></view><text>{{doc.title}}</text><text>{{doc.type}} · 点击查看图片与说明</text></button></view></view></block><block wx:if="{{item.video}}"><text class="section-title">开场片段</text><text wx:if="{{!videoSrc && !videoError}}" class="body btn-shine btn-shine-inline">正在准备开场片段。</text><video wx:if="{{videoSrc && !videoError}}" id="caseVideo" class="case-video" src="{{videoSrc}}" controls="{{true}}" autoplay="{{false}}" muted="{{true}}" show-fullscreen-btn="{{true}}" object-fit="contain" aria-label="LUSH 开场片段" binderror="onVideoError"></video><text wx:if="{{videoError}}" class="body" aria-live="polite">开场视频暂时无法加载，可返回欢迎页重新播放。</text><button class="replay" bindtap="replay" hover-class="press" aria-label="重播完整开场">体验完整开场 <text>></text></button></block><view wx:for="{{item.media}}" wx:key="*this" class="extra-media"><image wx:if="{{index>0 && !failedMedia[index]}}" src="{{item}}" mode="widthFix" data-src="{{item}}" data-media-index="{{index}}" aria-label="{{item.title}}补充图片" bindtap="preview" binderror="imageError"></image><view wx:if="{{index>0 && failedMedia[index]}}" class="media-missing" aria-label="图片暂时无法加载">图片暂时无法加载</view></view><button class="end-back" bindtap="back" hover-class="press" aria-label="返回作品列表">返回作品</button></block><view wx:else class="missing"><text>作品暂时不可用</text><button bindtap="back" aria-label="返回作品列表">返回作品列表</button></view></view></scroll-view></view><view wx:if="{{documentPreview}}" class="document-preview-layer" catchtap="closeDocumentPreview"><view class="document-preview-panel" catchtap="noop"><view class="document-preview-header"><text>{{documentPreview.title}} / 预览</text><button bindtap="closeDocumentPreview" aria-label="关闭资料预览">×</button></view><scroll-view scroll-y class="document-preview-scroll"><view class="document-preview-image-wrap"><view wx:if="{{documentPreviewLoading}}" class="document-preview-loading btn-shine" aria-live="polite">正在加载页面预览</view><image wx:if="{{!documentPreviewFailed}}" class="document-preview-image" src="{{documentPreview.preview}}" mode="aspectFit" bindload="documentPreviewLoad" bindtap="previewDocumentImage" binderror="documentPreviewError" aria-label="点击查看{{documentPreview.title}}大图"></image><view wx:else class="media-missing document-preview-missing" aria-label="图片暂时无法加载">图片暂时无法加载</view></view><view class="document-preview-copy"><view class="document-preview-kicker"><text>DESIGN NOTE</text><text>{{documentPreview.type}}</text></view><text class="document-preview-title">设计说明</text><view class="document-preview-note"><text>设计思路</text><text>{{documentPreview.notes.idea}}</text></view><view class="document-preview-note"><text>设计过程</text><text>{{documentPreview.notes.process}}</text></view><view class="document-preview-note"><text>思考</text><text>{{documentPreview.notes.thinking}}</text></view><view class="document-preview-note"><text>遇到的问题</text><text>{{documentPreview.notes.problems}}</text></view><view class="document-preview-note"><text>不足之处</text><text>{{documentPreview.notes.limitations}}</text></view></view></scroll-view><button class="document-preview-pdf" bindtap="openDocumentPreviewPdf" aria-label="打开当前资料 PDF">打开 PDF</button></view></view>
